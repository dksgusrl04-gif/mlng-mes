# server/.env 로 복사해서 값을 채운다:  cp .env.example .env
# ⚠ .env 는 깃에 올리지 않는다 (.gitignore 에 있음)

# DB 관리자 · API 계정 비밀번호 — 길고 무작위로 (예: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-admin
API_DB_PASSWORD=change-me-api

# 화면이 apikey 헤더로 보내는 공개 키 (Supabase anon 키 역할 — 공개돼도 되는 값, 비우면 검사 안 함)
PUBLIC_API_KEY=mlng_public_change_me

# 질의응답 (비우면 AI 질의는 규칙 기반만)
ANTHROPIC_API_KEY=
ASK_MODEL=

# 도메인 (HTTPS 를 켤 때 필요, 없으면 _ 로 두고 IP 로 접속)
DOMAIN=_
LETSENCRYPT_EMAIL=
PLANT_NAME=MLNG 데모 공장

# 내 PC 에서 80 번이 이미 쓰이면 바꾼다 (http://localhost:8080)
WEB_PORT=80

# 다른 주소에서 API 를 부를 때만 (같은 서버 화면만 쓰면 그대로)
ALLOW_ORIGINS=*
